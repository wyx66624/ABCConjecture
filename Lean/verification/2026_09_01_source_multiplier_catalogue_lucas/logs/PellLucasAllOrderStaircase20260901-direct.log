IUTThreeClosures.PellLucasAllOrderStaircase20260901.evenPowerSum_append (U : ℤ) (as bs : List ℤ) :
  evenPowerSum U (as ++ bs) = evenPowerSum U as + U ^ (2 * as.length) * evenPowerSum U bs
IUTThreeClosures.PellLucasAllOrderStaircase20260901.coprime_add_square_tail (U a h : ℤ) (ha : IsCoprime a U) :
  IsCoprime (a + U ^ 2 * h) U
