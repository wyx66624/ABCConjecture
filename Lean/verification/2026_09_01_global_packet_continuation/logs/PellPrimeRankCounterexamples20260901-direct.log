IUTThreeClosures.PellPrimeRankCounterexamples20260901.exists_prime_repeated_value_with_nonsingular_derivative :
  ∃ F q x, Nat.Prime q ∧ ↑q ∣ eval x F ∧ ¬↑q ∣ eval x (derivative F) ∧ ↑q ^ 2 ∣ eval x F
IUTThreeClosures.PellPrimeRankCounterexamples20260901.not_derivative_nonzero_forces_prime_square_not_dvd :
  ¬∀ (F : ℤ[X]) (q : ℕ) (x : ℤ), Nat.Prime q → ↑q ∣ eval x F → ¬↑q ∣ eval x (derivative F) → ¬↑q ^ 2 ∣ eval x F
IUTThreeClosures.PellPrimeRankCounterexamples20260901.printed_cyclotomic_quotient_counterexample_values :
  2 ^ 2 - 2 + 1 = 3 ∧ (2 ^ 6 - 1) / (2 ^ 2 - 1) = 21
IUTThreeClosures.PellPrimeRankCounterexamples20260901.not_printed_cyclotomic_quotient_identity :
  ¬2 ^ 2 - 2 + 1 = (2 ^ 6 - 1) / (2 ^ 2 - 1)
IUTThreeClosures.PellPrimeRankCounterexamples20260901.prime_index_order_one_exception_values :
