IUTThreeClosures.PellPrimeRankCounterexamples20260901.primeRankSevenPolynomial_eval_six :
  eval 6 primeRankSevenPolynomial = 40391
IUTThreeClosures.PellPrimeRankCounterexamples20260901.primeRankSevenPolynomial_derivative_eval_six :
  eval 6 (derivative primeRankSevenPolynomial) = 42408
IUTThreeClosures.PellPrimeRankCounterexamples20260901.primeRankSevenPolynomial_derivative_eval_six_mod_thirteen :
