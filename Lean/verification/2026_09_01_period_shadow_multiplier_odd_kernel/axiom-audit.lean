/-- Pure arithmetic form of the square-root vertical capacity argument. -/
theorem quadratic_card_bound_of_period
    {card H T capture D N K L : ℕ}
    (hT : 0 < T) (hL : 0 < L)
    (hcard : card ≤ H / T + 1)
    (hHL : H * L ≤ N)
    (hfactor : T * capture = D)
