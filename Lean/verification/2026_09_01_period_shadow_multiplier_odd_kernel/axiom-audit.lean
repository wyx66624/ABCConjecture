theorem directionCapture_vertical_le_quadratic
    (label : ArmDivisorLabel) {B C t XU : ℕ}
    (hB : 0 < B) (hC : 0 < C) (ht : 0 < t)
    (hUcap : label.u ≤ XU) :
    directionCapture label 0 (C * t) (B * t) ≤
      (XU * B * C) * t ^ 2 := by
  have hCt : 0 < C * t := mul_pos hC ht
  have hBt : 0 < B * t := mul_pos hB ht
