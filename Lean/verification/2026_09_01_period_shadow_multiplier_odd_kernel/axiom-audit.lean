  calc
    label.u * Nat.gcd label.v (C * t) * Nat.gcd label.w (B * t) ≤
        XU * (C * t) * (B * t) := by
      exact Nat.mul_le_mul (Nat.mul_le_mul hUcap hgV) hgW
