info: IUTThreeClosures/ResearchGaloisLifts20260830Audit.lean:16:0: def IUTThreeClosures.ABCConjecture : Prop :=
∀ (ε : ℝ),
  0 < ε →
    ∃ C,
      ∀ (a b c : ℕ),
        0 < a →
          0 < b →
            0 < c →
              a + b = c →
