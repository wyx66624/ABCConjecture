    | IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.ModelLabel.zeroKernel =>
      (↑(IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.endpointC n) ^ 2 -
            16 * ↑(IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.endpointC n) +
          16) ^
        3
    | IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.ModelLabel.aKernel =>
      8 *
        (↑(IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.endpointC n) ^ 2 +
              14 * ↑(IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.endpointC n) +
            1) ^
          3
    | IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.ModelLabel.negBKernel =>
      8 *
        (16 * ↑(IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.endpointC n) ^ 2 -
