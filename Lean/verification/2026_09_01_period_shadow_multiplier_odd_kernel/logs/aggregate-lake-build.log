  familyCurve n i =
    match i with
    | ModelLabel.original => IUTThreeClosures.abcFreyCurve (familyTriple n)
    | ModelLabel.zeroKernel => IUTThreeClosures.abcFreyTwoIsogenousCurve (familyTriple n)
    | ModelLabel.aKernel => IUTThreeClosures.abcFreyAtAQuotientCurve (familyTriple n)
