info: IUTThreeClosures/ResearchUniformContinuation20260831Audit.lean:151:0: IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.model_c4.{u} {R : Type u} [CommRing R] (c : R) (i : ModelLabel) :
  (model c i).c₄ =
    16 *
      match i with
      | ModelLabel.original => c ^ 2 - c + 1
      | ModelLabel.zeroKernel => c ^ 2 - 16 * c + 16
      | ModelLabel.aKernel => c ^ 2 + 14 * c + 1
      | ModelLabel.negBKernel => 16 * c ^ 2 - 16 * c + 1
info: IUTThreeClosures/ResearchUniformContinuation20260831Audit.lean:152:0: 'IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.model_c4' depends on axioms: [propext, Quot.sound]
info: IUTThreeClosures/ResearchUniformContinuation20260831Audit.lean:153:0: IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.model_discriminant.{u} {R : Type u} [CommRing R] (c : R)
  (i : ModelLabel) :
  (model c i).Δ =
    match i with
    | ModelLabel.original => 16 * (c - 1) ^ 2 * c ^ 2
    | ModelLabel.zeroKernel => -256 * (c - 1) * c ^ 4
    | ModelLabel.aKernel => 256 * c * (c - 1) ^ 4
    | ModelLabel.negBKernel => 256 * c * (c - 1)
info: IUTThreeClosures/ResearchUniformContinuation20260831Audit.lean:154:0: 'IUTThreeClosures.FreyEntireIsogenyArithmetic20260831.model_discriminant' depends on axioms: [propext, Quot.sound]
