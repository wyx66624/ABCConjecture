IUTThreeClosures.PellResidueParityLocalization20260901.exists_odd_rho_of_product.{u_1} {G : Type u_1} [CommMonoid G]
  (rho : G) (hrho : rho ^ 2 = 1) (hrho_ne : rho ≠ 1) (xs : List (G × ℕ)) (hclass : ∀ z ∈ xs, z.1 = 1 ∨ z.1 = rho)
