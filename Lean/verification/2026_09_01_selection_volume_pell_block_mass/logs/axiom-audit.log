IUTThreeClosures.PellResidueParityLocalization20260901.factorListPacket_forcedResidueDepthThree
  (P : ResidueFactorListPacket) :
  ((List.map (fun z => z.1 ^ z.2) (residueExponentList P.aFactors)).prod = 7 →
      ∃ z ∈ P.aFactors, ↑z.p = 7 ∧ Odd z.exponent ∧ 3 ≤ z.exponent) ∧
    ((List.map (fun z => z.1 ^ z.2) (residueExponentList P.bFactors)).prod = 5 →
      ∃ z ∈ P.bFactors, ↑z.p = 5 ∧ Odd z.exponent ∧ 3 ≤ z.exponent)
