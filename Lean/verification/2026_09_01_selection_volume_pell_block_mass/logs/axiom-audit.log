IUTThreeClosures.PellResidueParityLocalization20260901.pellUnitPair_fst_odd_residues (k : ℕ) :
  (pellUnitPair (8 * k + 1)).1 ≡ 1 [ZMOD 8] ∧
    (pellUnitPair (8 * k + 3)).1 ≡ 7 [ZMOD 8] ∧
      (pellUnitPair (8 * k + 5)).1 ≡ 1 [ZMOD 8] ∧ (pellUnitPair (8 * k + 7)).1 ≡ 7 [ZMOD 8]
