    (hUW : Nat.Coprime dU dW)
    (hVW : Nat.Coprime dV dW)
    (hvU : (dU : ℤ) ∣ v.1)
    (hvV : (dV : ℤ) ∣ v.1 + (C : ℤ) * v.2)
    (hvW : (dW : ℤ) ∣ v.1 + (B : ℤ) * v.2)
