IUTThreeClosures.PellLucasFactorQuotientProjectiveCoupling20260902.tripleCarrier_coefficients (t : ℤ) (rest : List ℤ) :
  ((t :: t :: t :: rest).sum, pairCoefficient (t :: t :: t :: rest), tripleCoefficient (t :: t :: t :: rest)) =
    (3 * t + rest.sum, 3 * t ^ 2 + 3 * t * rest.sum + pairCoefficient rest,
      t ^ 3 + 3 * t ^ 2 * rest.sum + 3 * t * pairCoefficient rest + tripleCoefficient rest)
IUTThreeClosures.PellLucasFactorQuotientProjectiveCoupling20260902.positiveCarrier_minimal_coefficients (k : ℤ) :
  ([k, k, k].sum, pairCoefficient [k, k, k], tripleCoefficient [k, k, k]) = (3 * k, 3 * k ^ 2, k ^ 3)
IUTThreeClosures.PellLucasFactorQuotientProjectiveCoupling20260902.negativeCarrier_minimal_coefficients (h : ℤ) :
  ([-h, -h, -h].sum, pairCoefficient [-h, -h, -h], tripleCoefficient [-h, -h, -h]) = (-3 * h, 3 * h ^ 2, -h ^ 3)
