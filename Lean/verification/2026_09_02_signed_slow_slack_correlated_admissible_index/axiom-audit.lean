/-! ## Shifted energy to global energy -/

/-- Optimal singleton-plus-shifted cubic conversion. -/
theorem cube_le_one_add_seven_shiftedCube (n : ℕ) :
    n ^ 3 ≤ 1 + 7 * (n - 1) ^ 3 := by
  by_cases hn0 : n = 0
