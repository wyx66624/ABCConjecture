theorem weightedShiftedEnergy_mul_scaledAmbientCube_le_armMoment
    {α : Type*} (s : Finset α) (weight count arm : α → ℕ)
    {N L : ℕ}
    (hcap : ∀ i ∈ s, (count i - 1) * N * L < arm i) :
