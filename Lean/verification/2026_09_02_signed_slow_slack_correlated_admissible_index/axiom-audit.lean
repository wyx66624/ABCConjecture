    (hspan : H * L ≤ N)
    (hfactor : T * capture = D)
    (hlarge : N ^ 2 < D) :
    (card - 1) ^ 2 * T * L ^ 2 < capture := by
  let a := card - 1
  have haT : a * T ≤ H := shiftedCard_mul_period_le hcard
  have haTL : a * T * L ≤ N :=
    (Nat.mul_le_mul_right L haT).trans hspan
