theorem crossOrderDeterminant_zero
    (U ell v wr ws Er Es Tr Ts : ℤ)
    (hell : IsCoprime ell (U ^ 2))
    (hr : ell * Tr ≡ wr * v * Er [ZMOD U ^ 2])
