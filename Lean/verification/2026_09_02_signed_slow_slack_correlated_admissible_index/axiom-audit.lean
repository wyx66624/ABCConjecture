    a ^ 2 * T * L ^ 2 = (a * T * L) * (a * L) := by ring
    _ ≤ N * (a * L) := Nat.mul_le_mul_right (a * L) haTL
    _ = a * N * L := by ring
    _ < capture := by simpa [a] using hlin

