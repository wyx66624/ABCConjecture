#print axioms sqrtTwoOrbit_norm
#print axioms pellOrbit_eq_sqrtTwo_square
#print axioms even_adjacent_square_shapes
#print axioms odd_adjacent_square_shapes
#print axioms isKFull_mul
#print axioms isKFull_factors_of_coprime_product
#print axioms pellOrbit_snd_twoFull_iff

end

end PellSquareRootDescent20260831
end IUTThreeClosures
