import IUTThreeClosures.TateParameterUnitBallRegion

/-!
# Nested regions generated by actual Tate-parameter powers

For a Tate parameter `q`, the regions `qⁿ · O` form a nested family.  When a
uniformizer `π` is fixed, the `n`-th region is exactly

`π^(n * ord_π(q)) · O`.

Thus the natural exponent used by a local theta/Kummer output generated by
powers of the actual Tate parameter is not an arbitrary natural number: it is
the product of the output power with the canonical normalized order of `q`.
This is the local arithmetic input needed to instantiate the generic
componentwise-minimum theta-hull calculation.
-/

namespace TateCurvesTheta

open scoped Pointwise

variable {K : Type*} [NormedField K]

namespace TateParameter

/-- The norm-unit-ball region scaled by the `n`-th power of the actual Tate
parameter. -/
def qPowerRegion (t : TateParameter K) (n : ℕ) : Set K :=
  scaledRegion ((t.q : K) ^ n) (normIntegralRegion (K := K))

/-- The image definition agrees with the pointwise scalar-set presentation
used by public packet hulls. -/
theorem qPowerRegion_eq_pow_smul
    (t : TateParameter K) (n : ℕ) :
    t.qPowerRegion n =
      ((t.q : K) ^ n) • normIntegralRegion (K := K) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y, hy, by simp [qPowerRegion, scaledRegion, smul_eq_mul]⟩
  · rintro ⟨y, hy, hxy⟩
    refine ⟨y, hy, ?_⟩
    simpa [qPowerRegion, scaledRegion, smul_eq_mul] using hxy.symm

@[simp]
theorem qPowerRegion_zero (t : TateParameter K) :
    t.qPowerRegion 0 = normIntegralRegion (K := K) := by
  simp [qPowerRegion, scaledRegion, normIntegralRegion]

/-- Zero belongs to every Tate-power region. -/
theorem zero_mem_qPowerRegion (t : TateParameter K) (n : ℕ) :
    (0 : K) ∈ t.qPowerRegion n := by
  refine ⟨0, ?_, by simp [qPowerRegion, scaledRegion]⟩
  simp [normIntegralRegion]

/-- Tate-power regions are antitone in the exponent. -/
theorem qPowerRegion_antitone
    (t : TateParameter K) {m n : ℕ} (hmn : m ≤ n) :
    t.qPowerRegion n ⊆ t.qPowerRegion m := by
  rintro x ⟨y, hy, rfl⟩
  refine ⟨((t.q : K) ^ (n - m)) * y, ?_, ?_⟩
  · change ‖((t.q : K) ^ (n - m)) * y‖ ≤ 1
    have hpow : ‖(t.q : K)‖ ^ (n - m) ≤ 1 :=
      pow_le_one₀ (norm_nonneg _) t.norm_lt_one.le
    calc
      ‖((t.q : K) ^ (n - m)) * y‖ =
          ‖(t.q : K)‖ ^ (n - m) * ‖y‖ := by
        rw [norm_mul, norm_pow]
      _ ≤ 1 * 1 :=
        mul_le_mul hpow hy (norm_nonneg _) (by norm_num)
      _ = 1 := by norm_num
  · calc
      (t.q : K) ^ n * y =
          (t.q : K) ^ (m + (n - m)) * y := by
        rw [Nat.add_sub_of_le hmn]
      _ = (t.q : K) ^ m *
          (((t.q : K) ^ (n - m)) * y) := by
        rw [pow_add]
        ring

/-- The actual `qⁿ`-region is the uniformizer-power region whose exponent is
`n * ord_π(q)`. -/
theorem qPowerRegion_eq_uniformizerPower
    (t : TateParameter K) {π : K} (hπ : IsUniformizer π) (n : ℕ) :
    t.qPowerRegion n =
      scaledRegion
        (π ^ (n * (t.toOrdered hπ).orderNat))
        (normIntegralRegion (K := K)) := by
  unfold qPowerRegion
  apply scaledRegion_eq_of_norm_eq
  · exact pow_ne_zero _ t.q.ne_zero
  · rw [norm_pow, t.norm_q_eq_pow_orderNat hπ, norm_pow]
    rw [← pow_mul]
    congr 1
    omega

/-- The canonical uniformizer exponent of a Tate-power output. -/
def qPowerOrder
    (t : TateParameter K) {π : K} (hπ : IsUniformizer π) (n : ℕ) : ℕ :=
  n * (t.toOrdered hπ).orderNat

@[simp]
theorem qPowerRegion_eq_qPowerOrder
    (t : TateParameter K) {π : K} (hπ : IsUniformizer π) (n : ℕ) :
    t.qPowerRegion n =
      scaledRegion (π ^ t.qPowerOrder hπ n)
        (normIntegralRegion (K := K)) := by
  simpa [qPowerOrder] using t.qPowerRegion_eq_uniformizerPower hπ n

end TateParameter

end TateCurvesTheta
