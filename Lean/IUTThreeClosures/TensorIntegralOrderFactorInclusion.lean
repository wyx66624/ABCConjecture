import Mathlib.Algebra.Algebra.Operations
import Mathlib.LinearAlgebra.PiTensorProduct
import IUTThreeClosures.SemisimplePacketCoordinates

/-!
# The tensor integral order maps into every primitive factor order

Let `k` be the rational local base ring, let `A j` be the label-wise local
algebras, and let `O j ⊆ A j` be their integral orders.  Inside the n-ary
tensor algebra `⨂[k] j, A j`, define the tensor integral order to be the subring
generated by the images of all `O j` under the canonical tensor-factor maps.

For any algebra homomorphism from the tensor algebra to a target field, if
every label-wise integral generator maps into a target subring `S`, then the
entire generated tensor integral order maps into `S`.  Applying this to every
maximal-ideal quotient of a finite-etale tuple algebra proves the algebraic
inclusion

`O_tensor ⊆ ∏_d O_d`

once the canonical factor maps are proved integral on each label order.

This is the inclusion half of the integral-order comparison.  Finiteness of
the index and its bound by the different/discriminant remain separate
arithmetic theorems; they are not hidden in the coordinate equivalence.
-/

namespace IUTThreeClosures

open PiTensorProduct

universe u v w

section GeneratedTensorOrder

variable (k : Type u) [CommRing k]
variable (Label : Type v) [Finite Label]
variable (A : Label → Type w)
variable [∀ j, CommRing (A j)]
variable [∀ j, Algebra k (A j)]
variable (O : ∀ j, Subring (A j))

/-- The canonical factor embedding into the n-ary tensor algebra. -/
noncomputable def tensorFactorAlgHom (j : Label) :
    A j →ₐ[k] (⨂[k] i : Label, A i) :=
  PiTensorProduct.algebraMap j

/-- Images of all label-wise integral elements in the tensor algebra. -/
def tensorIntegralGenerators : Set (⨂[k] i : Label, A i) :=
  {x | ∃ j (a : O j), x = tensorFactorAlgHom k Label A j a}

/-- The tensor integral order, generated by the actual label-wise integral
orders under the canonical tensor-factor maps. -/
noncomputable def tensorIntegralOrder : Subring (⨂[k] i : Label, A i) :=
  Subring.closure (tensorIntegralGenerators k Label A O)

/-- Universal factor theorem: integrality on every label generator implies
integrality of the full tensor order. -/
theorem tensorIntegralOrder_map_le
    {L : Type*} [CommRing L] [Algebra k L]
    (f : (⨂[k] i : Label, A i) →ₐ[k] L)
    (S : Subring L)
    (hgen : ∀ j (a : O j), f (tensorFactorAlgHom k Label A j a) ∈ S) :
    (tensorIntegralOrder k Label A O).map f.toRingHom ≤ S := by
  rw [tensorIntegralOrder, Subring.map_le_iff_le_comap]
  apply Subring.closure_le.2
  intro x hx
  rcases hx with ⟨j, a, rfl⟩
  exact hgen j a

/-- Elementwise form of the universal factor theorem. -/
theorem tensorIntegralOrder_apply_mem
    {L : Type*} [CommRing L] [Algebra k L]
    (f : (⨂[k] i : Label, A i) →ₐ[k] L)
    (S : Subring L)
    (hgen : ∀ j (a : O j), f (tensorFactorAlgHom k Label A j a) ∈ S)
    {x : (⨂[k] i : Label, A i)}
    (hx : x ∈ tensorIntegralOrder k Label A O) :
    f x ∈ S := by
  exact tensorIntegralOrder_map_le k Label A O f S hgen ⟨x, hx, rfl⟩

end GeneratedTensorOrder

section PrimitiveFactors

variable {k : Type u} [Field k] {Tuple : Type v}
variable (P : TupleFiniteEtalePacket.{u, v, w} k Tuple)
variable (Label : Type v) [Finite Label]
variable (A : Label → Type w)
variable [∀ j, CommRing (A j)] [∀ j, Algebra k (A j)]
variable (O : ∀ j, Subring (A j))
variable (identify : (⨂[k] j : Label, A j) ≃ₐ[k] ∀ c, P.AlgebraAt c)

/-- The canonical map from the tensor algebra to one primitive field factor. -/
noncomputable def primitiveFactorMap
    (d : P.RefinedComponent) :
    (⨂[k] j : Label, A j) →ₐ[k] P.Summand d :=
  (Pi.algHomProjection d.1).comp identify.toAlgHom |>.then
    (Ideal.Quotient.mkₐ k d.2.asIdeal)

/-- The product of target factor orders. -/
def productSubring
    (targetOrder : ∀ d : P.RefinedComponent, Subring (P.Summand d)) :
    Subring (∀ d : P.RefinedComponent, P.Summand d) where
  carrier := {x | ∀ d, x d ∈ targetOrder d}
  zero_mem' d := (targetOrder d).zero_mem
  one_mem' d := (targetOrder d).one_mem
  add_mem' hx hy d := (targetOrder d).add_mem (hx d) (hy d)
  mul_mem' hx hy d := (targetOrder d).mul_mem (hx d) (hy d)
  neg_mem' hx d := (targetOrder d).neg_mem (hx d)

@[simp]
theorem mem_productSubring
    (targetOrder : ∀ d : P.RefinedComponent, Subring (P.Summand d))
    (x : ∀ d : P.RefinedComponent, P.Summand d) :
    x ∈ productSubring P targetOrder ↔ ∀ d, x d ∈ targetOrder d :=
  Iff.rfl

/-- Simultaneous factor inclusion. If every primitive factor map sends every
label-wise integral generator into its canonical factor order, then the
coordinate image of the entire tensor integral order belongs to the product
of those factor orders. -/
theorem tensorIntegralOrder_all_factors
    (targetOrder : ∀ d : P.RefinedComponent, Subring (P.Summand d))
    (hgen : ∀ d j (a : O j),
      primitiveFactorMap P Label A identify d
          (tensorFactorAlgHom k Label A j a) ∈ targetOrder d)
    {x : (⨂[k] j : Label, A j)}
    (hx : x ∈ tensorIntegralOrder k Label A O) :
    (fun d => primitiveFactorMap P Label A identify d x) ∈
      productSubring P targetOrder := by
  intro d
  exact tensorIntegralOrder_apply_mem k Label A O
    (primitiveFactorMap P Label A identify d) (targetOrder d)
    (hgen d) hx

end PrimitiveFactors

end IUTThreeClosures
