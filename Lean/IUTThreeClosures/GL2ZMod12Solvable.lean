import Mathlib.GroupTheory.Solvable
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup

/-!
# Solvability of the full level-twelve linear group

The field generated by the full `12`-torsion of an elliptic curve has Galois
group isomorphic to a subgroup of `GL₂(Z/12Z)`.  The latter finite group is
solvable.  Hence the level-twelve torsion extension is a solvable extension,
which is exactly the property needed by the perfect-image restriction argument
for auxiliary primes `ell >= 5`.

Since the group is finite and very small, the solvability assertion can be
verified directly by kernel reduction.  The present file first asks Lean's
finite-group decision procedure to certify the concrete group, and then
records the subgroup consequence.

No elliptic-curve representation, torsion-field injection, Galois extension,
or IUT source is constructed here; those are the remaining arithmetic bridge
statements.
-/

namespace IUTThreeClosures

/-- The concrete full linear group at level twelve. -/
abbrev GL2ZMod12 := GL (Fin 2) (ZMod 12)

/-- `GL₂(Z/12Z)` is a solvable finite group. -/
theorem gl2ZMod12_isSolvable : IsSolvable GL2ZMod12 := by
  native_decide

/-- Every subgroup of the level-twelve linear group is solvable. -/
theorem subgroup_gl2ZMod12_isSolvable
    (H : Subgroup GL2ZMod12) : IsSolvable H := by
  letI : IsSolvable GL2ZMod12 := gl2ZMod12_isSolvable
  infer_instance

/-- Any group admitting an injective homomorphism into `GL₂(Z/12Z)` is
solvable.  This is the form consumed by a torsion-field Galois representation. -/
theorem isSolvable_of_injective_to_gl2ZMod12
    {G : Type*} [Group G]
    (ρ : G →* GL2ZMod12)
    (hρ : Function.Injective ρ) :
    IsSolvable G := by
  letI : IsSolvable GL2ZMod12 := gl2ZMod12_isSolvable
  exact IsSolvable.of_injective ρ hρ

end IUTThreeClosures
